---
import '../../styles/site.css';
import { loadContent } from '../../lib/content.mjs';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectDialog from '../../components/ProjectDialog.astro';
import { categories } from '../../lib/categories.mjs';
const { demo, settings, projects } = await loadContent({ ...import.meta.env, ...process.env });
// Only sub-categories that have at least one project get a chip.
const subfilters = Object.entries(categories).flatMap(([kind, list]) => list
  .map(item => ({ ...item, kind, count: projects.filter(project => project.kind === kind && project.categories?.includes(item.value)).length }))
  .filter(item => item.count));
const counts = { all: projects.length, photo: projects.filter(project => project.kind === 'photo').length, video: projects.filter(project => project.kind === 'video').length };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>All projects | {settings.brandName}</title>
    <meta name="description" content={`Explore all photography and film projects by ${settings.brandName}.`} />
    <meta name="theme-color" content="#11120f" />
    {demo && <meta name="robots" content="noindex,nofollow" />}
    {Astro.site && <link rel="canonical" href={new URL('/projects/', Astro.site)} />}
    <link rel="icon" type="image/png" href="/nr-favicon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${settings.brandName} home`}><img src="/nr-favicon.png" alt="" width="64" height="64" /></a>
      <nav aria-label="Main navigation"><a href="/projects/" aria-current="page">Work</a><a href="/#services">Services</a><a href="/#about">Contact</a></nav>
    </header>
    <main id="main" class="projects-page">
      <div class="projects-bar">
        <h1>All projects</h1>
        <div class="projects-toolbar">
          <div class="project-filters" role="group" aria-label="Filter projects by media type" hidden>
            {(['all', 'photo', 'video'] as const).map(kind => <button type="button" data-filter={kind} aria-pressed={String(kind === 'all')} aria-controls="projects-grid">{kind}<span>({counts[kind]})</span></button>)}
          </div>
          <div class="project-subfilters" role="group" aria-label="Filter by sub-category" hidden>
            <button type="button" data-sub="all" aria-pressed="true" aria-controls="projects-grid">All</button>
            {subfilters.map(item => <button type="button" data-kind={item.kind} data-sub={item.value} data-title={item.title} aria-pressed="false" aria-controls="projects-grid">{item.title}<span class="subfilter-count">({item.count})</span></button>)}
          </div>
          <button type="button" class="category-chip" aria-controls="projects-grid" hidden><span class="category-name"></span><span aria-hidden="true">✕</span><span class="visually-hidden">Clear category filter</span></button>
          <p id="project-count" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
        </div>
      </div>
      {demo && <p class="sample-notice">Local layout preview with sample projects.</p>}
      <div id="projects-grid" class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} demo={demo} variant="tile" />)}</div>
      <p id="projects-empty" class="empty-state" hidden={projects.length > 0}>New projects are on the way.</p>
      <div class="focus-blur focus-blur-top" aria-hidden="true"></div>
      <div class="focus-blur focus-blur-bottom" aria-hidden="true"></div>
    </main>
    <ProjectDialog projects={projects} />
    <script src="../../scripts/project-grid.ts"></script>
    <script src="../../scripts/motion.ts"></script>
  </body>
</html>
