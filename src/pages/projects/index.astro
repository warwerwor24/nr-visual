---
import '../../styles/site.css';
import { loadContent } from '../../lib/content.mjs';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectDialog from '../../components/ProjectDialog.astro';
const { demo, settings, projects } = await loadContent({ ...import.meta.env, ...process.env });
const logo = settings.logo || '/nrvisual-logo-transparent.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>All projects | {settings.brandName}</title>
    <meta name="description" content={`Explore all photography and film projects by ${settings.brandName}.`} />
    <meta name="theme-color" content="#11120f" />
    {demo && <meta name="robots" content="noindex,nofollow" />}
    {Astro.site && <link rel="canonical" href={new URL('/projects/', Astro.site)} />}
    <link rel="icon" type="image/png" href="/nr-favicon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${settings.brandName} home`}><img src={logo} alt={settings.brandName} width="1636" height="310" /></a>
      <nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#services">Services</a><a href="/#about">Contact</a></nav>
    </header>
    <main id="main" class="projects-page">
      <div class="projects-heading"><a class="back-link" href="/#work">← Back to featured work</a><h1>ALL PROJECTS</h1></div>
      {demo && <p class="sample-notice">Local layout preview with sample projects.</p>}
      <div class="projects-toolbar">
        <div class="project-filters" role="group" aria-label="Filter projects by media type" hidden>
          <button type="button" data-filter="all" aria-pressed="true" aria-controls="projects-grid">All</button>
          <button type="button" data-filter="photo" aria-pressed="false" aria-controls="projects-grid">Photo</button>
          <button type="button" data-filter="video" aria-pressed="false" aria-controls="projects-grid">Video</button>
        </div>
        <p id="project-count" class="project-count" role="status" aria-live="polite" aria-atomic="true">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
      </div>
      <div id="projects-grid" class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} demo={demo} />)}</div>
      <p id="projects-empty" class="empty-state" hidden={projects.length > 0}>New projects are on the way.</p>
    </main>
    <footer class="footer"><img class="footer-logo" src={logo} alt={settings.brandName} width="1636" height="310" loading="lazy" /><p>© {new Date().getFullYear()} {settings.brandName}. All rights reserved.</p></footer>
    <ProjectDialog projects={projects} />
    <script>
      const filters = document.querySelector<HTMLElement>('.project-filters')!;
      const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
      const cards = [...document.querySelectorAll<HTMLButtonElement>('.projects-grid .work-card')];
      const count = document.querySelector<HTMLElement>('#project-count')!;
      const empty = document.querySelector<HTMLElement>('#projects-empty')!;

      filters.hidden = false;
      function applyFilter(kind: string | undefined) {
        cards.forEach(card => { card.hidden = kind !== 'all' && card.dataset.kind !== kind; });
        const visible = cards.filter(card => !card.hidden).length;
        count.textContent = `${visible} ${kind === 'all' ? '' : `${kind} `}${visible === 1 ? 'project' : 'projects'}`;
        empty.hidden = visible > 0;
        empty.textContent = kind === 'all' ? 'New projects are on the way.' : `No ${kind} projects yet. Check back soon or select All.`;
      }
      buttons.forEach(button => button.addEventListener('click', () => {
        const kind = button.dataset.filter;
        buttons.forEach(option => option.setAttribute('aria-pressed', String(option === button)));
        if (!('startViewTransition' in document) || matchMedia('(prefers-reduced-motion: reduce)').matches) return applyFilter(kind);
        // Names exist only during the transition so cards never pair up with homepage cards across pages.
        cards.forEach((card, index) => { card.style.viewTransitionName = `project-card-${index}`; });
        document.startViewTransition(() => applyFilter(kind)).finished.finally(() => cards.forEach(card => { card.style.viewTransitionName = ''; }));
      }));
    </script>
    <script src="../../scripts/motion.ts"></script>
  </body>
</html>
