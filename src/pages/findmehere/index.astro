---
import '../../styles/site.css';
import '../../styles/links.css';
import { loadContent } from '../../lib/content.mjs';
import { whatsappUrl } from '../../lib/media.mjs';
import { photoUrl } from '../../lib/cover.mjs';

const { demo, settings } = await loadContent({ ...import.meta.env, ...process.env });
const logo = settings.logo || '/nrvisual-logo-transparent.png';
const email = 'nouvalrla@gmail.com';
// The banner is always portrait here, so the phone cut of the showreel wins when it exists.
const showreel = settings.heroVideoMobile || settings.heroVideo;
const poster = photoUrl(settings.heroPortrait?.url || '/hero-portrait-rim-light.jpg', 960);
const links = [
  { label: 'WhatsApp', href: settings.whatsapp || whatsappUrl('628176383770'), detail: "Let's talk about your vision", primary: true },
  { label: 'Website', href: '/', detail: 'Slide in for more of my works' },
  { label: 'Instagram', href: settings.instagram || 'https://www.instagram.com/ivalrz/', detail: '@ivalrz' },
  { label: 'LinkedIn', href: settings.linkedin || 'https://www.linkedin.com/in/nouvalrla/', detail: 'Get to know my career' },
  { label: 'Email', href: `mailto:${email}`, detail: email },
];
const description = `Showreel and contact links for ${settings.brandName}.`;
const shareImage = new URL('/hero-portrait-rim-light.jpg', Astro.site || Astro.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Find Me Here | NR Visual</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11120f" />
    {demo && <meta name="robots" content="noindex,nofollow" />}
    {Astro.site && <link rel="canonical" href={new URL('/findmehere', Astro.site)} />}
    <meta property="og:title" content="Find Me Here | NR Visual" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {Astro.site && <meta property="og:url" content={new URL('/findmehere', Astro.site)} />}
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/png" href="/nr-favicon.png" />
  </head>
  <body class="links-body">
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="links-page">
      <h1 class="links-logo"><img src={logo} alt={settings.brandName} width="1636" height="310" fetchpriority="high" /></h1>

      <section class="links-reel" aria-label="Showreel">
        {showreel
          ? <video class="hero-media" poster={poster} muted loop playsinline preload="metadata" aria-label="Showreel of selected work"><source src={showreel} /></video>
          : <img class="hero-media" src={poster} alt="" width="960" height="1200" />}
        <p class="links-reel-meta">NRVISUAL's Creative Works</p>
      </section>

      <nav class="links-destinations" aria-labelledby="links-title">
        <h2 class="section-label" id="links-title"><span>Get in touch</span></h2>
        {links.map((link, index) => <a class:list={['links-destination', { 'links-destination-primary': link.primary }]} href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>
          <span class="links-destination-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="links-destination-label">{link.label}</span>
          <span class="links-destination-detail">{link.detail}</span>
        </a>)}
      </nav>
      <footer class="links-footer"><p>© {new Date().getFullYear()} {settings.brandName}</p></footer>
    </main>
    <script>
      // Owner removed the pause button; reduced motion still keeps the poster.
      const video = document.querySelector('.hero-media');
      if (video instanceof HTMLVideoElement && !matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
    </script>
  </body>
</html>
