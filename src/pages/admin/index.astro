<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Admin setup | NR Visual</title></head><body><main><a href="/">Back to portfolio</a><p>NR VISUAL / ADMIN</p><h1>{configured ? 'Open Sanity Studio' : 'Your portfolio admin is ready to connect.'}</h1><p>{configured ? 'Sign in with the Google account that owns your NR Visual project to manage projects and website settings.' : 'This preview is not connected to a Sanity account yet. The project includes the editor for projects, highlights, your logo and contact details.'}</p>{configured && import.meta.env.DEV && <a href="https://nr-visual-n4rtv48x.sanity.studio/">Open portfolio editor ↗</a>}{!configured && <p>Follow the setup guide included with the website to connect your own Sanity project.</p>}</main><style>body{margin:0;background:#11120f;color:#f7f6d9;font-family:Arial,sans-serif}main{max-width:700px;margin:12vh auto;padding:30px}h1{font-size:clamp(36px,6vw,62px);letter-spacing:-2px}p{line-height:1.8;color:#bbbdae}a{color:#f7f6d9;display:inline-block;padding:14px 0}a:focus-visible{outline:3px solid #dee789}</style></body></html>
