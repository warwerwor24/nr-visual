---
import '../styles/site.css';
import { loadContent } from '../lib/content.mjs';
import { whatsappUrl } from '../lib/media.mjs';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import CoverImage from '../components/CoverImage.astro';
const { demo, settings, highlights, collage, projects } = await loadContent({ ...import.meta.env, ...process.env });
const logo = settings.logo || '/nrvisual-logo-transparent.png';
const whatsapp = settings.whatsapp || whatsappUrl('628176383770');
const instagram = settings.instagram || 'https://www.instagram.com/ivalrz/';
const linkedin = settings.linkedin || 'https://www.linkedin.com/in/nouvalrla/';
const portfolioBrands = [
  { alt: "For Skin's Sake", url: '/client-logos/for-skins-sake-white.png' },
  { alt: 'Buttered', url: '/client-logos/buttered.png' },
  { alt: 'SKAK Studios', url: '/client-logos/skak-studios-white.png' },
  { alt: 'Telkomsel', url: '/client-logos/telkomsel.png' },
  { alt: 'Yanmar', url: '/client-logos/yanmar.png' },
  { alt: 'BBYU', url: '/client-logos/bbyu-transparent.png' },
  { alt: 'Kokola', url: '/client-logos/kokola.png' },
  { alt: 'London Taxi', url: '/client-logos/london-taxi.png', tone: 'badge' },
];
const clientLogos = settings.clientLogos?.length ? settings.clientLogos : demo ? portfolioBrands : [];
const portrait = '/hero-portrait-rim-light.jpg';
const shareImage = new URL(portrait, Astro.site || Astro.url).href;
const all = [...new Map([...projects, ...highlights, ...collage].map(project => [project._id, project])).values()];
const services = [
  ['Brand Campaign Video', 'Films for new ideas, new products and the moments a brand wants to be seen.'],
  ['Event Videography', 'The atmosphere, the people and everything that makes the moment worth keeping.'],
  ['Offline & Online Editing', 'Story, pacing and finishing. Bringing your footage together into a complete film.'],
  ['Color Grading & VFX', 'Color, mood and visual effects that support the story in every frame.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NR Visual Works</title>
    <meta name="description" content={settings.heroText} />
    <meta name="theme-color" content="#11120f" />
    {demo && <meta name="robots" content="noindex,nofollow" />}
    {Astro.site && <link rel="canonical" href={Astro.site} />}
    <meta property="og:title" content="NR Visual Works" />
    <meta property="og:description" content={settings.heroText} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/png" href="/nr-favicon.png" />
    {demo && <link rel="preconnect" href="https://images.unsplash.com" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#top" aria-label={`${settings.brandName} home`}>
        <img src={logo} alt={settings.brandName} width="1636" height="310" />
      </a>
      <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#services">Services</a><a href="#about">Contact</a></nav>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <img class="hero-portrait" src={portrait} alt="Nouval against a blue backdrop with rim light around his hair." width="2752" height="1536" fetchpriority="high" />
        <div class="hero-shade" aria-hidden="true"></div>
        <p class="hero-kicker">Experienced visual creative</p>
        <ul class="hero-services" aria-label="Services">{services.map(([title]) => <li>{title}</li>)}</ul>
        <div class="hero-description"><p><span>Make every</span><span>idea matter.</span></p></div>
        <h1 id="hero-title"><img src={logo} alt={settings.brandName} width="1636" height="310" /></h1>
      </section>
      <section class="work section-pad" id="work" aria-labelledby="work-title">
        <div class="section-heading"><div class="work-heading-content">
          <a class="all-projects-link" href="/projects/" aria-label="See all projects">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span class="all-projects-label">See all projects</span>
          </a>
          <h2 id="work-title">WORK</h2>
        </div></div>
        <div class="work-grid">
          {highlights.map((project, index) => <ProjectCard project={project} index={index} demo={demo} />)}
          {!highlights.length && <p class="empty-state">New films are on the way.</p>}
        </div>
      </section>
      <section class="collection" id="collection" aria-labelledby="collection-title">
        <div class="collage-stage">
          <h2 id="collection-title">MAKE EVERY<br />IDEA MATTER.</h2>
          <div class="collage-grid">
            {collage.map((project, index) => <button class={`collage-card position-${index % 15}`} data-project={project._id} aria-label={`Open ${project.title}${demo ? ', sample project' : ''}`}>
              <CoverImage project={project} variant="gallery" width={320} height={400} />
              <span data-collage-title={project.title} title={project.title}>{project.title}</span>
            </button>)}
          </div>
        </div>
        {!collage.length && <p class="empty-state">The next collection is taking shape.</p>}
      </section>
      <section id="services" class="services section-pad" aria-labelledby="services-title">
        <div class="section-heading"><h2 id="services-title">WHAT I DO</h2></div>
        <div class="service-list">{services.map(([title, description], index) => <div class="service-row"><span class="service-number">0{index + 1}</span><h3>{title}</h3><p>{description}</p></div>)}</div>
      </section>
      {(demo || clientLogos.length > 0) && <section class="clients section-pad" aria-labelledby="clients-title">
        <div class="clients-heading"><h2 id="clients-title">CLIENTS</h2></div>
        <ul class="client-logos">
          {clientLogos.map(client => <li class={client.tone ? `client-${client.tone}` : undefined}><img src={client.url} alt={client.alt} width="220" height="80" loading="lazy" /></li>)}
          <li class="client-euromedica"><img src="/client-logos/euromedica.png" alt="Euromedica" width="220" height="80" loading="lazy" /></li>
        </ul>
        <p class="clients-more">and many more..</p>
      </section>}
      <section id="about" class="about section-pad" aria-labelledby="about-title">
        <h2 id="about-title"><span>{settings.experienceYears || 8} YEARS</span><br />OF EXPERIENCE.</h2>
        <p class="about-tagline">YOUR VISION IN FOCUS.</p>
        <div class="about-bottom"><p>{settings.aboutText}</p><div class="connect" id="connect">
          <a class="contact-button" href={whatsapp} target="_blank" rel="noopener noreferrer">Let's talk!</a>
          <div class="social-links">
            <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram: ivalrz"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn: Nouval"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42ZM19 18.75h-2.94v-4.64c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.72H9.78V9.2h2.82v1.31h.04c.39-.74 1.35-1.52 2.78-1.52 2.97 0 3.58 1.95 3.58 4.48v5.28Z"/></svg><span>LinkedIn</span></a>
            <span class="contact-location"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>Jakarta, Indonesia</span></span>
          </div>
        </div></div>
      </section>
    </main>
    <footer class="footer"><img class="footer-logo" src={logo} alt={settings.brandName} width="1636" height="310" loading="lazy" /><p>© {new Date().getFullYear()} {settings.brandName}. All rights reserved.</p></footer>
    <ProjectDialog projects={all} />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
