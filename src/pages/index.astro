---
import '../styles/site.css';
import { loadCachedContent } from '../lib/content.mjs';
import { whatsappUrl } from '../lib/media.mjs';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import CoverImage from '../components/CoverImage.astro';
import { photoUrl } from '../lib/cover.mjs';
import { clientMatches, clientSlug } from '../lib/clients.mjs';
const { demo, settings, highlights, collage, projects } = await loadCachedContent({ ...import.meta.env, ...process.env });
const logo = settings.logo || '/nrvisual-logo-transparent.png';
const whatsapp = settings.whatsapp || whatsappUrl('628176383770');
const instagram = settings.instagram || 'https://www.instagram.com/ivalrz/';
const linkedin = settings.linkedin || 'https://www.linkedin.com/in/nouvalrla/';
const portfolioBrands = [
  { alt: "For Skin's Sake", url: '/client-logos/for-skins-sake-white.png' },
  { alt: 'Buttered', url: '/client-logos/buttered.png' },
  { alt: 'SKAK Studios', url: '/client-logos/skak-studios-white.png' },
  { alt: 'Telkomsel', url: '/client-logos/telkomsel.png' },
  { alt: 'Ardiles', url: '/client-logos/ardiles.png' },
  { alt: 'Yanmar', url: '/client-logos/yanmar.png' },
  { alt: 'BBYU', url: '/client-logos/bbyu-transparent.png' },
  { alt: 'Kokola', url: '/client-logos/kokola.png' },
  { alt: 'London Taxi', url: '/client-logos/london-taxi.png', tone: 'badge' },
];
const clientLogos = [...(settings.clientLogos?.length ? settings.clientLogos : demo ? portfolioBrands : []), { alt: 'Euromedica', url: '/client-logos/euromedica.png', tone: 'euromedica' }]
  // A logo links to the archive only when at least one published project belongs to that client.
  .map(client => ({ ...client, href: projects.some(project => clientMatches(project, client.alt)) ? `/projects/?client=${clientSlug(client.alt)}` : undefined }));
const posterSource = settings.heroPortrait?.url || '/hero-portrait-rim-light.jpg';
// The Studio upload is a 1.8 MB PNG; Sanity resizes it and serves WebP/AVIF instead.
const poster = photoUrl(posterSource, 1920);
const posterSrcset = poster !== posterSource ? [960, 1600, 2400].map(width => `${photoUrl(posterSource, width)} ${width}w`).join(', ') : undefined;
const contactPhoto = settings.contactPhoto?.url ? settings.contactPhoto : { url: '/hero-portrait-rim-light.jpg', alt: 'Nouval against a blue backdrop with rim light around his hair.' };
const shareImage = new URL(poster, Astro.site || Astro.url).href;
// Empty slots are topped up with the newest other projects so both layouts always look complete.
const fill = (picked, count, pool) => [...picked, ...pool.filter(project => !picked.some(item => item._id === project._id))].slice(0, count);
const featured = fill(highlights, 11, projects.filter(project => project.kind === 'video'));
const floating = fill(collage, 8, projects);
const all = [...new Map([...projects, ...featured, ...floating].map(project => [project._id, project])).values()];
// Rows open the full archive; service names are not project categories.
const services = [
  ['Brand Campaign Video', 'Films for new ideas, new products and the moments a brand wants to be seen.'],
  ['Event Videography', 'The atmosphere, the people and everything that makes the moment worth keeping.'],
  ['Offline & Online Editing', 'Story, pacing and finishing. Bringing your footage together into a complete film.'],
  ['Color Grading & VFX', 'Color, mood and visual effects that support the story in every frame.'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NR Visual Works</title>
    <meta name="description" content={settings.heroText} />
    <meta name="theme-color" content="#11120f" />
    {demo && <meta name="robots" content="noindex,nofollow" />}
    {Astro.site && <link rel="canonical" href={Astro.site} />}
    <meta property="og:title" content="NR Visual Works" />
    <meta property="og:description" content={settings.heroText} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/png" href="/nr-favicon.png" />
    {demo && <link rel="preconnect" href="https://images.unsplash.com" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="#top" aria-label={`${settings.brandName} home`}><img src="/nr-favicon.png" alt="" width="64" height="64" /></a>
      <nav aria-label="Main navigation"><a href="/projects/">Work</a><a href="#services">Services</a><a href="#about">Contact</a></nav>
    </header>
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        {settings.heroVideo
          ? <video class="hero-media" src={settings.heroVideo} poster={poster} muted loop playsinline preload="metadata" aria-label="Showreel of selected work"></video>
          : <img class="hero-media" src={poster} srcset={posterSrcset} sizes={posterSrcset ? '100vw' : undefined} alt="" width="2752" height="1536" fetchpriority="high" />}
        <div class="hero-copy">
          <h1 id="hero-title">{settings.heroText}</h1>
          <div class="hero-meta">
            <span>NRVISUAL's Creative Works</span>
            <span class="hero-actions"><a href="#work">Scroll <span aria-hidden="true">↓</span></a>{settings.heroVideo && <button class="hero-toggle" type="button" aria-label="Pause showreel" hidden>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path class="icon-pause" d="M7 5h3v14H7zM14 5h3v14h-3z" fill="currentColor" /><path class="icon-play" d="m8 5 11 7-11 7Z" fill="currentColor" /></svg>
            </button>}</span>
          </div>
        </div>
      </section>
      <section class="work section-pad" id="work" aria-labelledby="work-title">
        <div class="work-grid">
          <div class="work-intro">
            <h2 id="work-title">FEATURED<br />WORK</h2>
            <a class="all-projects-link" href="/projects/">See all works <span class="link-arrow" aria-hidden="true">→</span><span class="link-count">{String(projects.length).padStart(2, '0')} projects</span></a>
          </div>
          {featured.map((project, index) => <ProjectCard project={project} index={index} demo={demo} />)}
          {!featured.length && <p class="empty-state">New films are on the way.</p>}
        </div>
      </section>
      <section class="collection" id="collection" aria-labelledby="collection-title">
        <canvas class="pixel-aura" aria-hidden="true"></canvas>
        <div class="collage-stage">
          <h2 id="collection-title">WE GIVE<br />YOU A POINT<br />OF VIEW</h2>
          <div class="collage-grid">
            {floating.map((project, index) => {
              // Covers keep their own shape: landscape stays landscape, portrait stays portrait.
              const size = project.coverSize;
              const landscape = size?.width > size?.height;
              const width = landscape ? 480 : 320;
              return <button class={`collage-card position-${index}${landscape ? ' is-landscape' : ''}`} data-project={project._id} aria-label={`Open ${project.title}${demo ? ', sample project' : ''}`}>
                <CoverImage project={project} width={width} height={size ? Math.round(width * size.height / size.width) : 400} />
              </button>;
            })}
          </div>
        </div>
        {!floating.length && <p class="empty-state">The next collection is taking shape.</p>}
      </section>
      <section id="services" class="services section-pad" aria-labelledby="services-title">
        <div class="section-label"><h2 id="services-title">What I do</h2><span>Full service production</span></div>
        <ul class="service-list">{services.map(([title, description], index) => <li><a class="service-row" href="/projects/">
          <h3>{title}</h3><span class="service-number">0{index + 1}</span><p>{description}</p><span class="service-arrow" aria-hidden="true">→</span>
        </a></li>)}</ul>
      </section>
      {(demo || clientLogos.length > 1) && <section class="clients section-pad" aria-labelledby="clients-title">
        <h2 id="clients-title">CLIENTS</h2>
        <ul class="client-logos">
          {clientLogos.map(client => {
            const logo = <img src={client.url} alt={client.alt} width="300" height="120" loading="lazy" />;
            return <li class={client.tone ? `client-${client.tone}` : undefined}>{client.href ? <a class="client-link" href={client.href} aria-label={`${client.alt} projects`}>{logo}</a> : logo}</li>;
          })}
        </ul>
      </section>}
      <section id="about" class="about section-pad" aria-labelledby="about-title">
        <div class="about-photo"><img src={contactPhoto.url} alt={contactPhoto.alt} width="2752" height="1536" loading="lazy" /></div>
        <div class="about-body">
          <div class="section-label"><span>Contact</span><span>Jakarta, Indonesia</span></div>
          <h2 id="about-title"><span>{settings.experienceYears || 8} YEARS</span><br />OF EXPERIENCE.</h2>
          <p class="about-tagline">YOUR VISION IN FOCUS.</p>
          <div class="connect" id="connect">
            <a class="contact-button" href={whatsapp} target="_blank" rel="noopener noreferrer">Get in touch</a>
          </div>
        </div>
      </section>
    </main>
    <footer class="footer">
      <div class="footer-top"><a class="footer-mark" href="#top" aria-label={`${settings.brandName} home`}><img src="/nr-favicon.png" alt="" width="64" height="64" loading="lazy" /></a><p>© {new Date().getFullYear()} {settings.brandName}. All rights reserved.</p><nav aria-label="Social links"><a href={instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a></nav></div>
      <img class="footer-logo" src={logo} alt={settings.brandName} width="1636" height="310" loading="lazy" />
    </footer>
    <ProjectDialog projects={all} />
    <script src="../scripts/pixel-aura.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/hero-video.ts"></script>
  </body>
</html>
