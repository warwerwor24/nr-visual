---
import { driveMedia, videoAspectRatio, videoFileUrl } from '../lib/media.mjs';
import CoverImage from './CoverImage.astro';
import { coverPresentation, photoUrl } from '../lib/cover.mjs';
import { loadCachedContent } from '../lib/content.mjs';
import { projectSlugs } from '../lib/project-url.mjs';
const { projects } = Astro.props;
// Slugs come from the full archive so every page links a project to the same /projects/<slug>/ URL.
const slugs = projectSlugs((await loadCachedContent({ ...import.meta.env, ...process.env })).projects);
---
<dialog id="project-dialog" aria-labelledby="dialog-title">
  <button class="dialog-focus" aria-label="Enter focus mode" aria-pressed="false" title="Focus mode"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5"/></svg></button>
  <button class="dialog-close" aria-label="Close project" autofocus><span aria-hidden="true">×</span></button>
  <div class="dialog-content">
  <div class="dialog-stage">
    <div class="dialog-shell"><header class="dialog-header"><h2 id="dialog-title"></h2></header>
    <div id="dialog-media"></div>
    </div>
    <button class="dialog-info-toggle" type="button" aria-expanded="false" aria-controls="dialog-info" hidden><span>Show description</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" /></svg></button>
    <section class="dialog-info" id="dialog-info" aria-labelledby="description-title"><dl id="dialog-meta" class="dialog-meta"></dl><h3 id="description-title">Description</h3><p id="dialog-description"></p><p id="media-status" class="visually-hidden" role="status"></p></section>
  </div>
  <div class="dialog-navigation">
    <div class="dialog-arrows">
      <button class="dialog-arrow dialog-prev" aria-label="Previous project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 14 6-6 6 6" /></svg></button>
      <button class="dialog-arrow dialog-next" aria-label="Next project"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 10 6 6 6-6" /></svg></button>
    </div>
  <ul class="dialog-gallery" aria-label="Browse projects">{projects.map(project => <li><button class="dialog-thumbnail" data-dialog-project={project._id} aria-label={`Open ${project.title}`} aria-pressed="false"><CoverImage project={project} alt="" width={160} height={100} /><span class="visually-hidden">{project.title}</span></button></li>)}</ul>
  </div>
  </div>
  <section class="photo-viewer" hidden aria-labelledby="photo-view-title">
    <header class="photo-view-header"><button class="photo-back" type="button" aria-label="Close photo and return to album"><span aria-hidden="true">×</span></button><h2 id="photo-view-title"></h2><time class="photo-view-date"></time></header>
    <div class="photo-view-stage">
      <div class="photo-peek photo-peek-prev" aria-hidden="true"><img alt="" /></div>
      <figure class="photo-view-main">
        <div class="photo-view-focus">
          <img class="photo-view-image" alt="" />
          <button class="photo-step photo-prev" type="button" aria-label="Previous photo"><span aria-hidden="true">‹</span></button>
          <button class="photo-step photo-next" type="button" aria-label="Next photo"><span aria-hidden="true">›</span></button>
        </div>
        <figcaption class="photo-view-status" role="status"></figcaption>
      </figure>
      <div class="photo-peek photo-peek-next" aria-hidden="true"><img alt="" /></div>
    </div>
    <ul class="photo-filmstrip" aria-label="Photos in this album"></ul>
  </section>
</dialog>
<div hidden id="project-templates">{projects.map(project => <template data-project-template={project._id} data-kind={project.kind} data-title={project.title} data-slug={slugs.get(project._id) || ''} data-client={project.client || ''} data-role={project.role || ''} data-completed-at={project.completedAt || ''} data-description={project.description || ''} data-ratio={videoAspectRatio(project.videoFormat)} data-embed={project.kind === 'video' ? driveMedia(project.driveUrl)?.embed || '' : ''} data-video={project.kind === 'video' ? videoFileUrl(project.videoUrl) || '' : ''} data-poster={project.kind === 'video' && project.cover ? coverPresentation(project, 960, 'work', videoAspectRatio(project.videoFormat)).src : ''}>
  {(!driveMedia(project.driveUrl) || project.kind === 'photo') && <div class="photo-gallery">{(project.kind === 'photo' ? project.photos : [{ url: project.cover, alt: project.alt }]).filter(photo => photo?.url).map((photo, index) => <button type="button" class="photo-tile" style={photo.lqip ? `background-image:url(${photo.lqip})` : undefined} data-photo-index={index} aria-label={`View photo ${index + 1}: ${photo.alt || project.title}`}><img src={photoUrl(photo.url)} data-full-src={photoUrl(photo.url, 2000)} alt={photo.alt} width={photo.width || undefined} height={photo.height || undefined} loading="lazy" decoding="async" data-fade /></button>)}</div>}
</template>)}</div>
<script src="../scripts/dialog.ts"></script>
<script src="../scripts/fit-project-titles.ts"></script>
<script src="../scripts/image-fade.ts"></script>
