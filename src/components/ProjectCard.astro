---
import CoverImage from './CoverImage.astro';
const { project, index = 0, demo = false } = Astro.props;
---
<button class="work-card" data-project={project._id} data-kind={project.kind} aria-label={`${project.kind === 'video' ? 'Watch' : 'Open'} ${project.title}${demo ? ', sample project' : ''}`}>
  <span class="cover-frame">
    <CoverImage project={project} loading={index < 3 ? 'eager' : 'lazy'} />
    <span class="card-top">{!demo && <span>{[project.category, ...(project.videoSubcategories ?? [])].join(' · ')}</span>}<span class="card-number">{String(index + 1).padStart(2, '0')}</span></span>
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none">{project.kind === 'video' ? <path d="m8 5 11 7-11 7Z" fill="currentColor" /> : <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="2" />}</svg></span>
    <span class="cover-caption">{project.title}</span>
  </span>
</button>
<script src="../scripts/fit-project-titles.ts"></script>
