---
import CoverImage from './CoverImage.astro';
import { categoryTitle } from '../lib/categories.mjs';
const { project, index = 0, demo = false, variant = 'card', clients } = Astro.props;
const tile = variant === 'tile';
const number = String(index + 1).padStart(2, '0');
const label = (project.categories ?? []).map(value => categoryTitle(project.kind, value)).filter(Boolean).join(' · ');
const search = [project.title, project.client, label].filter(Boolean).join(' ').toLowerCase();
---
<button class={tile ? 'work-card project-tile' : 'work-card'} data-project={project._id} data-kind={project.kind} data-category={project.category} data-categories={(project.categories ?? []).join(' ')} data-clients={clients?.join(' ')} data-search={tile ? search : undefined} data-number={number} aria-label={`${project.kind === 'video' ? 'Watch' : 'Open'} ${project.title}${demo ? ', sample project' : ''}`}>
  <span class="cover-frame">
    <CoverImage project={project} loading={index < (tile ? 10 : 3) ? 'eager' : 'lazy'} width={tile ? 640 : 720} height={tile ? 360 : 405} sizes={tile ? '(max-width: 600px) 50vw, 25vw' : '(max-width: 600px) 90vw, 30vw'} />
    {!tile && project.kind === 'video' && project.previewClip && <video class="hover-clip" data-src={project.previewClip} muted loop playsinline preload="none" aria-hidden="true"></video>}
    <span class="card-top">{!demo && <span>{label}</span>}<span class="card-number">{number}</span></span>
    <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none">{project.kind === 'video' ? <path d="m8 5 11 7-11 7Z" fill="currentColor" /> : <path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="2" />}</svg></span>
    <span class="cover-caption">{project.title}</span>
  </span>
</button>
<script src="../scripts/fit-project-titles.ts"></script>
<script src="../scripts/hover-clips.ts"></script>
