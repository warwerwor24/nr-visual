{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build:release",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/links",
      "destination": "/findmehere",
      "permanent": true
    },
    {
      "source": "/links/",
      "destination": "/findmehere",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "https://nr-visual-n4rtv48x.sanity.studio/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://nr-visual-n4rtv48x.sanity.studio/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/video/:path*",
      "destination": "https://pub-637bcb44e3c64a508b9a56620024f35a.r2.dev/video/:path*"
    }
  ],
  "headers": [
    {
      "source": "/video/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
