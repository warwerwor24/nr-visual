{
  "name": "nr-visual-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "studio": "node --env-file-if-exists=.env scripts/studio.mjs",
    "studio:deploy": "node --env-file-if-exists=.env scripts/deploy-studio.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "build:release": "node --env-file-if-exists=.env scripts/build.mjs --release",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": "24.x" },
  "dependencies": {
    "@sanity/image-url": "2.1.1",
    "astro": "7.4.4",
    "sanity": "6.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.15"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "^1.9.1"
    },
    "undici@^7": "^7.30.1"
  }
}
