# Leave unset for the clearly labeled local sample preview.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Public canonical URL, only after a domain is chosen.
SITE_URL=
# Private dataset only: use a read-only token. Never prefix it PUBLIC_ or SANITY_STUDIO_.
SANITY_READ_TOKEN=
# Backend only: set a random secret of at least 32 characters in Vercel Production.
# Never prefix this secret with SANITY_STUDIO_ or PUBLIC_. Local Studio generates its own.
DRIVE_VIDEO_SIGNING_SECRET=
# Optional Studio build override. npm run studio uses its local video service automatically.
# SANITY_STUDIO_DRIVE_VIDEO_URL=https://nr-visual.vercel.app/api/drive-video
